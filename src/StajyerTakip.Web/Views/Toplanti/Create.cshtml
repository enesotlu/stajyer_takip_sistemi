@model ToplantiCreateViewModel

@{
    ViewData["Title"] = "Yeni Toplantı";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel("Yeni Toplantı", "Oluşturduğunda tüm stajyerlerine otomatik olarak davet gönderilir."))" />

<div class="stk-form-kart">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Baslik" class="form-label"></label>
            <input asp-for="Baslik" class="form-control" />
            <span asp-validation-for="Baslik" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Tarih" class="form-label"></label>
            <input asp-for="Tarih" type="datetime-local" class="form-control" />
            <span asp-validation-for="Tarih" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Aciklama" class="form-label"></label>
            <textarea asp-for="Aciklama" class="form-control" rows="3" placeholder="Örn: Haftalık ilerleme değerlendirmesi."></textarea>
            <span asp-validation-for="Aciklama" class="text-danger"></span>
        </div>

        <div class="stk-form-eylemler">
            <button type="submit" class="btn btn-primary">Gönder</button>
            <a asp-action="Index" class="stk-btn-iptal">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
