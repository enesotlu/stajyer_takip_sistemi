@using StajyerTakip.Business.Models
@model RaporOzeti

@{
    ViewData["Title"] = "Raporlar";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel(
             "Raporlar",
             "Staj programının genel durumu: özet sayılar ve dağılım grafikleri."))" />

<div class="row row-cols-2 row-cols-md-3 row-cols-xl-6 g-3 mb-4">
    <div class="col">
        <div class="stk-stat-kart">
            <span class="stk-stat-ikon stk-stat-ikon-mavi"><partial name="_Ikon" model="@("kisiler")" /></span>
            <div>
                <div class="stk-stat-sayi">@Model.ToplamStajyer</div>
                <div class="stk-stat-etiket">Toplam Stajyer</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stk-stat-kart">
            <span class="stk-stat-ikon stk-stat-ikon-yesil"><partial name="_Ikon" model="@("kisi-onay")" /></span>
            <div>
                <div class="stk-stat-sayi">@Model.AktifStajyer</div>
                <div class="stk-stat-etiket">Aktif Stajyer</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stk-stat-kart">
            <span class="stk-stat-ikon stk-stat-ikon-mor"><partial name="_Ikon" model="@("canta")" /></span>
            <div>
                <div class="stk-stat-sayi">@Model.ToplamMentor</div>
                <div class="stk-stat-etiket">Mentör</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stk-stat-kart">
            <span class="stk-stat-ikon stk-stat-ikon-mor"><partial name="_Ikon" model="@("bina")" /></span>
            <div>
                <div class="stk-stat-sayi">@Model.ToplamDepartman</div>
                <div class="stk-stat-etiket">Departman</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stk-stat-kart">
            <span class="stk-stat-ikon stk-stat-ikon-amber"><partial name="_Ikon" model="@("kisi-onay")" /></span>
            <div>
                <div class="stk-stat-sayi">@Model.BekleyenMentorBasvurusu</div>
                <div class="stk-stat-etiket">Bekleyen Mentör Başvurusu</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stk-stat-kart">
            <span class="stk-stat-ikon stk-stat-ikon-amber"><partial name="_Ikon" model="@("kisi-arti")" /></span>
            <div>
                <div class="stk-stat-sayi">@Model.BekleyenStajyerBasvurusu</div>
                <div class="stk-stat-etiket">Bekleyen Stajyer Başvurusu</div>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="stk-stat-kart">
            <span class="stk-stat-ikon stk-stat-ikon-amber"><partial name="_Ikon" model="@("cikis")" /></span>
            <div>
                <div class="stk-stat-sayi">@Model.BekleyenIzinTalebi</div>
                <div class="stk-stat-etiket">Bekleyen İzin Talebi</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="stk-kart h-100">
            <h2 class="stk-grafik-baslik">Mentöre Göre Stajyer Dağılımı</h2>
            <canvas id="mentorGrafik"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stk-kart h-100">
            <h2 class="stk-grafik-baslik">Talep Durumu</h2>
            <canvas id="talepGrafik"></canvas>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stk-kart h-100">
            <h2 class="stk-grafik-baslik">Departmana Göre Stajyer</h2>
            <canvas id="departmanGrafik"></canvas>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        const mentorVerisi = @Json.Serialize(Model.MentorStajyerDagilimi);
        const talepVerisi = @Json.Serialize(Model.TalepDurumDagilimi);
        const departmanVerisi = @Json.Serialize(Model.DepartmanStajyerDagilimi);

        // Rozetlerle ayni anlam-renk eslesmesi: bekleyen=amber, tamam=yesil
        const durumRenkleri = {
            'Bekliyor': '#e9a23b',
            'Tamamlandi': '#2f9e5b'
        };

        const turkceEtiket = {
            'Bekliyor': 'Bekliyor',
            'Tamamlandi': 'Tamamlandı'
        };

        function halkaGrafik(id, veri) {
            const anahtarlar = Object.keys(veri);
            new Chart(document.getElementById(id), {
                type: 'doughnut',
                data: {
                    labels: anahtarlar.map(a => turkceEtiket[a] ?? a),
                    datasets: [{
                        data: Object.values(veri),
                        backgroundColor: anahtarlar.map(a => durumRenkleri[a] ?? '#2f6fed'),
                        borderWidth: 0
                    }]
                },
                options: {
                    cutout: '62%',
                    plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, boxHeight: 12 } } }
                }
            });
        }

        function cubukGrafik(id, veri, etiket, renk) {
            new Chart(document.getElementById(id), {
                type: 'bar',
                data: {
                    labels: Object.keys(veri),
                    datasets: [{
                        label: etiket,
                        data: Object.values(veri),
                        backgroundColor: renk,
                        borderRadius: 6,
                        maxBarThickness: 42
                    }]
                },
                options: {
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#eef2f7' } },
                        x: { grid: { display: false } }
                    },
                    plugins: { legend: { display: false } }
                }
            });
        }

        halkaGrafik('talepGrafik', talepVerisi);
        cubukGrafik('mentorGrafik', mentorVerisi, 'Stajyer sayısı', '#93731d');
        cubukGrafik('departmanGrafik', departmanVerisi, 'Stajyer sayısı', '#2f6fed');
    </script>
}
