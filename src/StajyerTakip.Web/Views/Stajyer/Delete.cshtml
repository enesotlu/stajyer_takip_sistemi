@model Stajyer

@{
    ViewData["Title"] = "Stajyer Sil";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel("Stajyeri Sil", "Bu işlem geri alınamaz; silmeden önce kontrol edin."))" />

<div class="stk-form-kart">
    <div class="stk-banner stk-banner-uyari">
        <partial name="_Ikon" model="@("unlem")" />
        <div>
            <strong>@Model.Okul</strong> / @Model.Bolum stajyerini silmek istediğine emin misin?
            Bu stajyere ait görev, devam ve değerlendirme kayıtları da silinecek.
        </div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="stk-form-eylemler">
            <button type="submit" class="btn btn-danger">Sil</button>
            <a asp-action="Index" class="stk-btn-iptal">Vazgeç</a>
        </div>
    </form>
</div>
