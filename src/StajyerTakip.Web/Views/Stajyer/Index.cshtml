@model List<Stajyer>

@{
    ViewData["Title"] = "Stajyerler";
    bool mentorGorunumu = User.IsInRole(Roller.Mentor) && !User.IsInRole(Roller.Yonetici);
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel(
             mentorGorunumu ? "Stajyerlerim" : "Stajyerler",
             mentorGorunumu
                 ? "Sorumlu olduğunuz stajyerleri görüntüleyin ve yönetin."
                 : "Sistemdeki stajyerleri görüntüleyin ve yönetin."))" />

<form method="get" asp-action="Index" class="stk-tablo-kart mb-3 d-flex gap-2 align-items-end flex-wrap" style="padding: 1rem">
    <div>
        <label class="form-label small mb-1">İsimle ara</label>
        <input type="search" name="ad" value="@ViewBag.AramaAd" class="form-control form-control-sm" style="width: 220px" placeholder="Ad Soyad..." />
    </div>
    <div>
        <label class="form-label small mb-1">Tarihte stajda olan</label>
        <input type="date" name="tarih" value="@ViewBag.AramaTarih" class="form-control form-control-sm" style="width: 170px" />
    </div>
    <button type="submit" class="btn btn-primary btn-sm">Filtrele</button>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Temizle</a>
    <a asp-action="ExcelIndir" asp-route-ad="@ViewBag.AramaAd" asp-route-tarih="@ViewBag.AramaTarih"
       class="btn btn-outline-success btn-sm ms-auto">
        <partial name="_Ikon" model="@("indir")" /> Excel'e Aktar
    </a>
</form>

@if (Model.Count == 0)
{
    <div class="stk-bos-durum">
        <partial name="_Ikon" model="@("kutu")" />
        <h2>@(string.IsNullOrWhiteSpace((string?)ViewBag.AramaAd) && ViewBag.AramaTarih is null ? "Henüz stajyer yok" : "Filtreye uyan stajyer bulunamadı")</h2>
        <p>Stajyerler, başvuruları onaylandığında burada listelenir.</p>
    </div>
}
else
{
    <div class="stk-tablo-kart">
        <table class="stk-tablo">
            <thead>
                <tr>
                    <th></th>
                    <th>Ad Soyad</th>
                    <th>Okul</th>
                    <th>Bölüm</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Durum</th>
                    <th>Mentör</th>
                    <th>Departman</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var stajyer in Model)
                {
                    bool aktif = stajyer.BaslangicTarihi.Date <= DateTime.Today && DateTime.Today <= stajyer.BitisTarihi.Date;
                    <tr>
                        <td>
                            <div class="stk-avatar stk-avatar-sm">
                                @if (stajyer.Kullanici.ProfilFotografUrl is not null)
                                {
                                    <img src="@stajyer.Kullanici.ProfilFotografUrl" alt="" />
                                }
                                else
                                {
                                    <partial name="_Ikon" model="@("kisi")" />
                                }
                            </div>
                        </td>
                        <td class="stk-hucre-ad">@stajyer.Kullanici.AdSoyad</td>
                        <td>@stajyer.Okul</td>
                        <td>@stajyer.Bolum</td>
                        <td>@stajyer.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                        <td>@stajyer.BitisTarihi.ToString("dd.MM.yyyy")</td>
                        <td>
                            @if (aktif)
                            {
                                <span class="stk-rozet stk-rozet-yesil">Aktif</span>
                            }
                            else
                            {
                                <span class="stk-rozet stk-rozet-gri">Pasif</span>
                            }
                        </td>
                        <td>@(stajyer.Mentor?.Kullanici?.AdSoyad ?? stajyer.Mentor?.Unvan ?? "—")</td>
                        <td>@stajyer.Departman.Ad</td>
                        <td>
                            <span class="stk-islem-hucre">
                                @if (mentorGorunumu)
                                {
                                    <a asp-controller="Devam" asp-action="Takvim" asp-route-stajyerId="@stajyer.Id" class="stk-ikon-btn" title="Devam Takvimi">
                                        <partial name="_Ikon" model="@("takvim")" />
                                    </a>
                                }
                                <a asp-action="Edit" asp-route-id="@stajyer.Id" class="stk-ikon-btn" title="Düzenle">
                                    <partial name="_Ikon" model="@("kalem")" />
                                </a>
                                <a asp-action="Delete" asp-route-id="@stajyer.Id" class="stk-ikon-btn stk-ikon-btn-tehlike" title="Sil">
                                    <partial name="_Ikon" model="@("cop")" />
                                </a>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
