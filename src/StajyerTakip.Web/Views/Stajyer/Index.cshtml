@model List<Stajyer>

@{
    ViewData["Title"] = "Stajyerler";
}

<h1>Stajyerler</h1>


<div class="table-wrap">
<table class="table table-striped mb-0">
    <thead>
        <tr>
            <th>Ad Soyad</th>
            <th>Okul</th>
            <th>Bölüm</th>
            <th>Başlangıç</th>
            <th>Bitiş</th>
            <th>Durum</th>
            <th>Mentör</th>
            <th>Departman</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var stajyer in Model)
        {
            bool aktif = stajyer.BaslangicTarihi.Date <= DateTime.Today && DateTime.Today <= stajyer.BitisTarihi.Date;
            <tr>
                <td>@stajyer.Kullanici.AdSoyad</td>
                <td>@stajyer.Okul</td>
                <td>@stajyer.Bolum</td>
                <td>@stajyer.BaslangicTarihi.ToString("dd.MM.yyyy")</td>
                <td>@stajyer.BitisTarihi.ToString("dd.MM.yyyy")</td>
                <td>
                    @if (aktif)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pasif</span>
                    }
                </td>
                <td>@(stajyer.Mentor?.Kullanici?.AdSoyad ?? stajyer.Mentor?.Unvan ?? "—")</td>
                <td>@stajyer.Departman.Ad</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@stajyer.Id" class="btn btn-sm btn-outline-secondary">Düzenle</a>
                    <a asp-action="Delete" asp-route-id="@stajyer.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
</div>
