@model List<Devam>

@{
    ViewData["Title"] = "Devam / Puantaj Onayı";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel(
             "Devam / Puantaj Onayı",
             "Stajyerlerinizin Külliye'ye giriş yaptığında otomatik oluşan devam kayıtlarını onaylayın, gerekirse saatini düzenleyin ya da kaldırın."))" />

@if (Model.Count == 0)
{
    <div class="stk-bos-durum">
        <partial name="_Ikon" model="@("takvim")" />
        <h2>Henüz devam kaydı yok</h2>
        <p>Stajyerleriniz Külliye'ye giriş yapıp konumu doğrulandığında burada görünür.</p>
    </div>
}
else
{
    <div class="stk-tablo-kart">
        <table class="stk-tablo">
            <thead>
                <tr>
                    <th>Stajyer</th>
                    <th>Tarih</th>
                    <th>Giriş</th>
                    <th>Çıkış</th>
                    <th>Konum</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var devam in Model)
                {
                    <tr>
                        <td class="stk-hucre-ad">@devam.Stajyer.Kullanici.AdSoyad</td>
                        <td>@devam.Tarih.ToString("dd.MM.yyyy")</td>
                        <td>@(devam.GirisSaati?.ToString(@"hh\:mm") ?? "—")</td>
                        <td>@(devam.CikisSaati?.ToString(@"hh\:mm") ?? "—")</td>
                        <td>
                            @if (devam.Enlem.HasValue && devam.Boylam.HasValue)
                            {
                                <a href="https://www.google.com/maps?q=@devam.Enlem.Value.ToString(System.Globalization.CultureInfo.InvariantCulture),@devam.Boylam.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                   target="_blank" rel="noopener" class="stk-btn-hafif stk-btn-hafif-mavi">
                                    <partial name="_Ikon" model="@("bilgi")" />
                                    Haritada Gör
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Mentör girdi</span>
                            }
                        </td>
                        <td><partial name="_OnayDurumRozet" model="devam.OnayDurumu" /></td>
                        <td>
                            <span class="stk-islem-hucre">
                                @if (devam.OnayDurumu == OnayDurumu.Bekliyor)
                                {
                                    <form asp-action="Onayla" asp-route-id="@devam.Id" method="post" class="d-inline">
                                        <button type="submit" class="stk-btn-hafif stk-btn-hafif-yesil">
                                            <partial name="_Ikon" model="@("onay")" />
                                            Onayla
                                        </button>
                                    </form>
                                    <form asp-action="Reddet" asp-route-id="@devam.Id" method="post" class="d-inline">
                                        <button type="submit" class="stk-btn-hafif stk-btn-hafif-kirmizi">
                                            <partial name="_Ikon" model="@("kapat")" />
                                            Reddet
                                        </button>
                                    </form>
                                }
                                <details class="stk-teslim-detay">
                                    <summary class="stk-btn-hafif stk-btn-hafif-amber">Düzenle</summary>
                                    <form asp-action="Edit" asp-route-id="@devam.Id" method="post" class="mt-2 d-flex gap-2 align-items-end flex-wrap">
                                        <div>
                                            <label class="form-label small mb-1">Giriş</label>
                                            <input type="time" name="girisSaati" class="form-control form-control-sm" value="@devam.GirisSaati?.ToString(@"hh\:mm")" required />
                                        </div>
                                        <div>
                                            <label class="form-label small mb-1">Çıkış</label>
                                            <input type="time" name="cikisSaati" class="form-control form-control-sm" value="@devam.CikisSaati?.ToString(@"hh\:mm")" required />
                                        </div>
                                        <button type="submit" class="stk-btn-hafif stk-btn-hafif-amber">Kaydet</button>
                                    </form>
                                </details>
                                <form asp-action="Delete" asp-route-id="@devam.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Bu devam kaydını kaldırmak istediğinize emin misiniz? Gün \'Yok\' olarak görünecek.');">
                                    <button type="submit" class="stk-ikon-btn stk-ikon-btn-tehlike" title="Kaldır (Yok yap)">
                                        <partial name="_Ikon" model="@("cop")" />
                                    </button>
                                </form>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
