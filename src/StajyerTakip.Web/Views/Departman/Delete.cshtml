@model Departman

@{
    ViewData["Title"] = "Departman Sil";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel("Departmanı Sil", "Bu işlem geri alınamaz; silmeden önce bilgileri kontrol edin."))" />

<div class="stk-form-kart">
    <div class="stk-banner stk-banner-uyari">
        <partial name="_Ikon" model="@("unlem")" />
        <div><strong>@Model.Ad</strong> departmanını silmek istediğine emin misin?</div>
    </div>

    <dl class="row mb-0">
        <dt class="col-sm-3">Ad</dt>
        <dd class="col-sm-9">@Model.Ad</dd>
        <dt class="col-sm-3">Açıklama</dt>
        <dd class="col-sm-9">@Model.Aciklama</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="stk-form-eylemler">
            <button type="submit" class="btn btn-danger">
                Sil
            </button>
            <a asp-action="Index" class="stk-btn-iptal">Vazgeç</a>
        </div>
    </form>
</div>
