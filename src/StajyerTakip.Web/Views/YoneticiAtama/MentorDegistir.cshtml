@using StajyerTakip.Core.Entities
@model Stajyer

@{
    ViewData["Title"] = "Mentör Değiştir";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel("Mentör Değiştir", $"{Model.Kullanici?.AdSoyad ?? "—"} için sorumlu mentörü değiştirin."))" />

<div class="stk-form-kart">
    <form asp-action="MentorDegistir" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Yeni Mentör</label>
            <select name="mentorId" asp-items="ViewBag.MentorId" class="form-select">
                <option value="">-- Mentör Seçin --</option>
            </select>
        </div>

        <div class="stk-form-eylemler">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="stk-btn-iptal">Vazgeç</a>
        </div>
    </form>
</div>
