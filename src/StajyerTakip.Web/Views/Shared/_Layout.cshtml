@{
    string Aktif(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    string adSoyad = User.FindFirst("AdSoyad")?.Value ?? User.Identity?.Name ?? "";
    string rolEtiketi = User.IsInRole(Roller.Yonetici) ? "Yönetici"
        : User.IsInRole(Roller.Mentor) ? "Mentör"
        : User.IsInRole(Roller.Stajyer) ? "Stajyer"
        : "Onay Bekliyor";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stajyer Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StajyerTakip.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="stk-sidebar">
            <a class="stk-sidebar-brand" asp-controller="Home" asp-action="Index">Stajyer Takip Sistemi</a>

            <nav class="stk-sidebar-nav" id="sidebarNav">
                <a class="@Aktif("Home")" asp-controller="Home" asp-action="Index">Ana Sayfa</a>

                @if (User.IsInRole(Roller.Yonetici))
                {
                    <div class="stk-nav-section">Yönetim</div>
                    <a class="@Aktif("OnayBekleyenler")" asp-controller="OnayBekleyenler" asp-action="Index">Onay Bekleyenler</a>
                    <a class="@Aktif("Departman")" asp-controller="Departman" asp-action="Index">Departmanlar</a>
                    <a class="@Aktif("Mentor")" asp-controller="Mentor" asp-action="Index">Mentörler</a>
                }

                @if (User.IsInRole(Roller.Yonetici) || User.IsInRole(Roller.Mentor))
                {
                    <div class="stk-nav-section">Staj Takibi</div>
                    <a class="@Aktif("Stajyer")" asp-controller="Stajyer" asp-action="Index">Stajyerler</a>
                    <a class="@Aktif("Gorev")" asp-controller="Gorev" asp-action="Index">Görevler</a>
                    <a class="@Aktif("Devam")" asp-controller="Devam" asp-action="Index">Devam Onayı</a>
                }

                @if (User.IsInRole(Roller.Stajyer))
                {
                    <div class="stk-nav-section">Staj İşlemlerim</div>
                    <a class="@Aktif("Gorevlerim")" asp-controller="Gorevlerim" asp-action="Index">Görevlerim</a>
                    <a class="@Aktif("Devamlarim")" asp-controller="Devamlarim" asp-action="Index">Devam Kayıtlarım</a>
                }

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="stk-nav-section">Hesap</div>
                    <a class="@Aktif("Profil")" asp-controller="Profil" asp-action="Index">Profilim</a>
                }
            </nav>

            <div class="stk-sidebar-user">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="stk-user-name">@adSoyad</span>
                    <span class="badge bg-primary mb-2">@rolEtiketi</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-link">Çıkış Yap</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="d-block mb-1">Giriş Yap</a>
                    <a asp-controller="Account" asp-action="Register" class="d-block">Kayıt Ol</a>
                }
            </div>
        </aside>

        <div class="stk-main">
            <div class="stk-topbar">
                <button type="button" id="sidebarToggle" class="btn btn-outline-secondary btn-sm">Menü</button>
                <span>@ViewData["Title"]</span>
            </div>

            <main role="main" class="stk-content">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebarNav').classList.toggle('stk-open');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
