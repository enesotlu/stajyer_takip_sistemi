@using StajyerTakip.Core.Identity
@using Microsoft.AspNetCore.Identity
@inject StajyerTakip.Business.Interfaces.ITalepService TalepServisi
@inject StajyerTakip.Business.Interfaces.IIzinService IzinServisi
@inject StajyerTakip.Business.Interfaces.IStajyerService StajyerServisi
@inject StajyerTakip.Business.Interfaces.IMentorService MentorServisi
@inject StajyerTakip.Business.Interfaces.IKullaniciYonetimService KullaniciYonetimServisi
@inject StajyerTakip.Business.Interfaces.IToplantiService ToplantiServisi
@inject StajyerTakip.Business.Interfaces.IDevamService DevamServisi
@inject StajyerTakip.Business.Interfaces.IGorevService GorevServisi
@inject UserManager<ApplicationUser> KullaniciYoneticisi
@{
    string Aktif(string controller) =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";

    string adSoyad = User.FindFirst("AdSoyad")?.Value ?? User.Identity?.Name ?? "";
    string kullanicininRolu = User.IsInRole(Roller.Yonetici) ? Roller.Yonetici
        : User.IsInRole(Roller.Mentor) ? Roller.Mentor
        : User.IsInRole(Roller.Stajyer) ? Roller.Stajyer
        : "";
    string rolEtiketi = RolGorunumleri.Ad(kullanicininRolu);
    string rolRozetSinifi = RolGorunumleri.RozetSinifi(kullanicininRolu);

    // Bildirim rozeti: stajyerin cevaplamadığı talep, cevaplamadığı toplantı daveti
    // ve henüz başlamadığı (yeni atanan) görev sayısı.
    int bekleyenTalepSayisi = 0;
    int bekleyenToplantiSayisi = 0;
    int bekleyenGorevSayisi = 0;
    if (User.IsInRole(Roller.Stajyer))
    {
        var kullaniciId = KullaniciYoneticisi.GetUserId(User);
        var stajyerProfili = kullaniciId is null ? null : await StajyerServisi.GetByKullaniciIdAsync(kullaniciId);
        if (stajyerProfili is not null)
        {
            bekleyenTalepSayisi = await TalepServisi.BekleyenSayisiAsync(stajyerProfili.Id);
            bekleyenToplantiSayisi = await ToplantiServisi.BekleyenSayisiAsync(stajyerProfili.Id);
            bekleyenGorevSayisi = await GorevServisi.BekleyenSayisiAsync(stajyerProfili.Id);
        }
    }

    // Bildirim rozeti: mentörün kendi stajyerlerinden bekleyen izin sayısı,
    // kendi departmanına yapılan bekleyen stajyer başvurusu sayısı, bekleyen
    // devam onayı sayısı ve stajyerlerin yeni teslim ettiği görev/cevapladığı talep sayısı.
    int bekleyenIzinSayisi = 0;
    int bekleyenStajyerBasvuruSayisi = 0;
    int bekleyenDevamSayisi = 0;
    int bekleyenGorevIncelemeSayisi = 0;
    int bekleyenTalepIncelemeSayisi = 0;
    if (User.IsInRole(Roller.Mentor))
    {
        var kullaniciId = KullaniciYoneticisi.GetUserId(User);
        var mentorProfili = kullaniciId is null ? null : await MentorServisi.GetByKullaniciIdAsync(kullaniciId);
        if (mentorProfili is not null)
        {
            bekleyenIzinSayisi = await IzinServisi.BekleyenSayisiAsync(mentorProfili.Id);
            bekleyenStajyerBasvuruSayisi = (await KullaniciYonetimServisi.GetStajyerBekleyenlerByDepartmanAsync(mentorProfili.DepartmanId))
                .Count(k => !k.BasvuruGorulduMu);
            bekleyenDevamSayisi = await DevamServisi.BekleyenSayisiAsync(mentorProfili.Id);
            bekleyenGorevIncelemeSayisi = await GorevServisi.MentorBekleyenSayisiAsync(mentorProfili.Id);
            bekleyenTalepIncelemeSayisi = await TalepServisi.MentorBekleyenSayisiAsync(mentorProfili.Id);
        }
    }

    // Bildirim rozeti: yöneticinin onaylaması gereken bekleyen mentör başvurusu sayısı.
    int bekleyenMentorBasvuruSayisi = 0;
    if (User.IsInRole(Roller.Yonetici))
    {
        bekleyenMentorBasvuruSayisi = (await KullaniciYonetimServisi.GetMentorBekleyenlerAsync()).Count(k => !k.BasvuruGorulduMu);
    }
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stajyer Takip Sistemi</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StajyerTakip.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="stk-sidebar">
            <a class="stk-sidebar-brand" asp-controller="Home" asp-action="Index">Stajyer Takip Sistemi</a>

            <nav class="stk-sidebar-nav" id="sidebarNav">
                <a class="@Aktif("Home")" asp-controller="Home" asp-action="Index"><partial name="_Ikon" model="@("ev")" /><span>Ana Sayfa</span></a>

                @if (User.IsInRole(Roller.Yonetici))
                {
                    <div class="stk-nav-section">Yönetim</div>
                    <a class="@Aktif("Rapor")" asp-controller="Rapor" asp-action="Index"><partial name="_Ikon" model="@("grafik")" /><span>Raporlar</span></a>
                    <a class="@Aktif("OnayBekleyenler")" asp-controller="OnayBekleyenler" asp-action="Index">
                        <partial name="_Ikon" model="@("kisi-onay")" /><span>Mentör Başvuruları</span>
                        @if (bekleyenMentorBasvuruSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenMentorBasvuruSayisi</span>
                        }
                    </a>
                    <a class="@Aktif("YoneticiAtama")" asp-controller="YoneticiAtama" asp-action="Index"><partial name="_Ikon" model="@("atama")" /><span>Mentör-Stajyer Ataması</span></a>
                    <a class="@Aktif("Kullanicilar")" asp-controller="Kullanicilar" asp-action="Index"><partial name="_Ikon" model="@("kisiler")" /><span>Kullanıcılar</span></a>
                    <a class="@Aktif("Departman")" asp-controller="Departman" asp-action="Index"><partial name="_Ikon" model="@("bina")" /><span>Departmanlar</span></a>
                    <a class="@Aktif("Mentor")" asp-controller="Mentor" asp-action="Index"><partial name="_Ikon" model="@("canta")" /><span>Mentörler</span></a>
                    <a class="@Aktif("Stajyer")" asp-controller="Stajyer" asp-action="Index"><partial name="_Ikon" model="@("kisi")" /><span>Stajyerler</span></a>
                }

                @if (User.IsInRole(Roller.Mentor))
                {
                    <div class="stk-nav-section">Staj Takibi</div>
                    <a class="@Aktif("Stajyer")" asp-controller="Stajyer" asp-action="Index"><partial name="_Ikon" model="@("kisiler")" /><span>Stajyerlerim</span></a>
                    <a class="@Aktif("Gorev")" asp-controller="Gorev" asp-action="Index">
                        <partial name="_Ikon" model="@("liste")" /><span>Ödevler</span>
                        @if (bekleyenGorevIncelemeSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenGorevIncelemeSayisi</span>
                        }
                    </a>
                    <a class="@Aktif("Devam")" asp-controller="Devam" asp-action="Index">
                        <partial name="_Ikon" model="@("takvim")" /><span>Devam Onayı</span>
                        @if (bekleyenDevamSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenDevamSayisi</span>
                        }
                    </a>
                    <a class="@Aktif("Toplanti")" asp-controller="Toplanti" asp-action="Index"><partial name="_Ikon" model="@("kisiler")" /><span>Toplantılar</span></a>
                    <a class="@Aktif("Izin")" asp-controller="Izin" asp-action="Index">
                        <partial name="_Ikon" model="@("cikis")" /><span>İzin Talepleri</span>
                        @if (bekleyenIzinSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenIzinSayisi</span>
                        }
                    </a>
                    <a class="@Aktif("Talep")" asp-controller="Talep" asp-action="Index">
                        <partial name="_Ikon" model="@("dosya")" /><span>Talepler</span>
                        @if (bekleyenTalepIncelemeSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenTalepIncelemeSayisi</span>
                        }
                    </a>
                    <a class="@Aktif("StajyerBasvuru")" asp-controller="StajyerBasvuru" asp-action="Index">
                        <partial name="_Ikon" model="@("kisi-arti")" /><span>Stajyer Başvuruları</span>
                        @if (bekleyenStajyerBasvuruSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenStajyerBasvuruSayisi</span>
                        }
                    </a>
                }

                @if (User.IsInRole(Roller.Stajyer))
                {
                    <div class="stk-nav-section">Staj İşlemlerim</div>
                    <a class="@Aktif("Gorevlerim")" asp-controller="Gorevlerim" asp-action="Index">
                        <partial name="_Ikon" model="@("liste")" /><span>Ödevlerim</span>
                        @if (bekleyenGorevSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenGorevSayisi</span>
                        }
                    </a>
                    <a class="@Aktif("Devamlarim")" asp-controller="Devamlarim" asp-action="Index"><partial name="_Ikon" model="@("takvim")" /><span>Devam Kayıtlarım</span></a>
                    <a class="@Aktif("Izinlerim")" asp-controller="Izinlerim" asp-action="Index"><partial name="_Ikon" model="@("cikis")" /><span>İzinlerim</span></a>
                    <a class="@Aktif("Toplantilarim")" asp-controller="Toplantilarim" asp-action="Index">
                        <partial name="_Ikon" model="@("kisiler")" /><span>Toplantılarım</span>
                        @if (bekleyenToplantiSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenToplantiSayisi</span>
                        }
                    </a>
                    <a class="@Aktif("Taleplerim")" asp-controller="Taleplerim" asp-action="Index">
                        <partial name="_Ikon" model="@("dosya")" /><span>Taleplerim</span>
                        @if (bekleyenTalepSayisi > 0)
                        {
                            <span class="badge rounded-pill bg-danger">@bekleyenTalepSayisi</span>
                        }
                    </a>
                }

                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <div class="stk-nav-section">Hesap</div>
                    <a class="@Aktif("Profil")" asp-controller="Profil" asp-action="Index"><partial name="_Ikon" model="@("kisi")" /><span>Profilim</span></a>
                }
            </nav>

            <div class="stk-sidebar-user">
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <span class="stk-user-name">@adSoyad</span>
                    <span class="stk-rozet @rolRozetSinifi mb-2">@rolEtiketi</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="btn btn-link">Çıkış Yap</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="d-block mb-1">Giriş Yap</a>
                    <a asp-controller="Account" asp-action="Register" class="d-block">Kayıt Ol</a>
                }
            </div>
        </aside>

        <div class="stk-main">
            <div class="stk-topbar">
                <button type="button" id="sidebarToggle" class="btn btn-outline-secondary btn-sm">Menü</button>
                <span>@ViewData["Title"]</span>
            </div>

            <main role="main" class="stk-content">
                <partial name="_DurumMesaji" />
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.getElementById('sidebarToggle')?.addEventListener('click', function () {
            document.getElementById('sidebarNav').classList.toggle('stk-open');
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
