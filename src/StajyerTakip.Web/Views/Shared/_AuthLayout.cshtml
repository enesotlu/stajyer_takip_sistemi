<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Stajyer Takip Sistemi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="stk-auth-split-body">
    <div class="stk-auth-split">
        <div class="stk-auth-left">
            <div class="stk-auth-left-inner">
                <div class="stk-auth-mini-brand">
                    <span class="stk-auth-logo-sm">ST</span>
                    <div>
                        <div class="stk-auth-mini-title">Stajyer Takip Sistemi</div>
                        <div class="stk-auth-mini-sub">Yazılım Daire Başkanlığı</div>
                    </div>
                </div>

                @RenderBody()

                <div class="stk-auth-left-footer">&copy; 2026 Stajyer Takip Sistemi</div>
            </div>
        </div>

        @* Sag panel kod tabanli (gradyan + doku), disaridan gorsel/forsu kullanilmiyor.
           Sol paneldeki baslik zaten ekran okuyucuda var, bu yuzden dekoratif kabul edip gizliyoruz. *@
        <div class="stk-auth-right" aria-hidden="true">
            <div class="stk-auth-right-pattern"></div>
            <div class="stk-auth-right-content">
                <div class="stk-auth-right-badge">ST</div>
                <div class="stk-auth-right-org">Yazılım Daire Başkanlığı</div>
                <span class="stk-auth-right-divider"></span>
                <h2 class="stk-auth-right-title">Stajyer Takip Sistemi</h2>
                <p class="stk-auth-right-desc">Üniversite stajyerleri eğitim programı kapsamında staj süreçlerinin uçtan uca takibi için geliştirilmiştir.</p>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelectorAll('.stk-parola-goster').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.closest('.stk-input-grup').querySelector('input');
                input.type = input.type === 'password' ? 'text' : 'password';
            });
        });

        // Cift gonderimi engelle: form gecerliyse butonu kilitle ve "yukleniyor" metnini goster.
        document.querySelectorAll('.stk-auth-left-inner form').forEach(function (form) {
            form.addEventListener('submit', function () {
                if (window.jQuery && jQuery.fn.valid && !jQuery(form).valid()) {
                    return; // istemci dogrulamasi gecmedi, buton serbest kalsin
                }
                var btn = form.querySelector('button[type="submit"]');
                if (!btn || btn.disabled) { return; }
                var metin = btn.getAttribute('data-yukleniyor') || 'Gönderiliyor...';
                // setTimeout: buton, submit tamamlanmadan disable olursa bazi tarayicilar gonderimi iptal eder
                setTimeout(function () {
                    btn.disabled = true;
                    btn.textContent = metin;
                }, 0);
            });
        });

        // Caps Lock uyarisi: sifre alanlarinin altinda kucuk gri not
        document.querySelectorAll('.stk-auth-left-inner .stk-parola-alani').forEach(function (input) {
            var uyari = document.createElement('div');
            uyari.className = 'stk-capslock-uyari';
            uyari.textContent = 'Caps Lock açık';
            uyari.hidden = true;
            input.closest('.stk-input-grup').insertAdjacentElement('afterend', uyari);

            function kontrol(e) {
                if (typeof e.getModifierState === 'function') {
                    uyari.hidden = !e.getModifierState('CapsLock');
                }
            }
            input.addEventListener('keydown', kontrol);
            input.addEventListener('keyup', kontrol);
            input.addEventListener('blur', function () { uyari.hidden = true; });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
