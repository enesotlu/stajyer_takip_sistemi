@model Gorev
@{
    // Son teslim tarihi gecmis ve hala tamamlanmamis gorevler DB'de Durum
    // degismeden "Yapilmadi" olarak gosterilir - Devam/Talep'teki ayni
    // "goruntulemede hesapla, veriyi bozma" deseni.
    var suresiGecti = Model.Durum != GorevDurumu.Tamamlandi && Model.TeslimTarihi.Date < DateTime.Today;

    var (sinif, metin) = suresiGecti
        ? ("stk-rozet-kirmizi", "Yapılmadı")
        : Model.Durum switch
        {
            GorevDurumu.Baslamadi => ("stk-rozet-gri", "Başlamadı"),
            GorevDurumu.DevamEdiyor => ("stk-rozet-mavi", "Devam Ediyor"),
            GorevDurumu.Tamamlandi => ("stk-rozet-yesil", "Tamamlandı"),
            _ => ("stk-rozet-gri", Model.Durum.ToString())
        };
}
<span class="stk-rozet @sinif">@metin</span>
