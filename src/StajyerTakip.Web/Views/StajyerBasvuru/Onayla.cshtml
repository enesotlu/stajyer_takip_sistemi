@model StajyerAtaViewModel

@{
    ViewData["Title"] = "Stajyer Başvurusunu Onayla";
}

<h1>Stajyer Başvurusunu Onayla</h1>
<p class="text-muted"><strong>@Model.AdSoyad</strong> (@Model.Email) için staj bilgilerini doldurun.</p>

<form asp-action="Onayla" method="post">
    <input type="hidden" asp-for="KullaniciId" />
    <input type="hidden" asp-for="AdSoyad" />
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="MentorId" />
    <input type="hidden" asp-for="DepartmanId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Okul" class="form-label"></label>
        <input asp-for="Okul" class="form-control" placeholder="Üniversite / Okul adı" />
        <span asp-validation-for="Okul" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Bolum" class="form-label"></label>
        <input asp-for="Bolum" class="form-control" placeholder="Bölüm adı" />
        <span asp-validation-for="Bolum" class="text-danger"></span>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="BaslangicTarihi" class="form-label"></label>
            <input asp-for="BaslangicTarihi" class="form-control" type="date" />
            <span asp-validation-for="BaslangicTarihi" class="text-danger"></span>
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="BitisTarihi" class="form-label"></label>
            <input asp-for="BitisTarihi" class="form-control" type="date" />
            <span asp-validation-for="BitisTarihi" class="text-danger"></span>
        </div>
    </div>

    <button type="submit" class="btn btn-primary">Onayla ve Stajyer Yap</button>
    <a asp-action="Index" class="btn btn-secondary">Vazgeç</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
