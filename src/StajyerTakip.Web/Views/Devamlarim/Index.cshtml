@using StajyerTakip.Business.Models
@model List<Devam>

@{
    ViewData["Title"] = "Devam Kayıtlarım";
    bool profilYok = ViewBag.ProfilYok;
}

<h1>Devam Kayıtlarım</h1>

@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

@if (profilYok)
{
    <div class="alert alert-warning">
        Hesabına bağlı bir Stajyer profili bulunamadı. Bu genelde kendi kendine "Kayıt Ol" ile hesap açtığında olur —
        devam kaydı girebilmen için Yöneticinin seni Stajyer olarak eklemesi (Okul/Bölüm/Mentör/Departman bilgilerinle) gerekiyor.
    </div>
}
else
{
    var ozet = (AylikDevamOzeti)ViewBag.AylikOzet;
    <div class="alert alert-info">
        <strong>@ozet.Ay.ToString("00")/@ozet.Yil özeti:</strong>
        Toplam @ozet.ToplamGun gün — Onaylanan @ozet.OnaylananGun, Bekleyen @ozet.BekleyenGun, Reddedilen @ozet.ReddedilenGun
    </div>

    <p>
        <a asp-action="Create" class="btn btn-primary">Bugün İçin Kayıt Gir</a>
    </p>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Tarih</th>
                <th>Giriş</th>
                <th>Çıkış</th>
                <th>Durum</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var devam in Model)
            {
                <tr>
                    <td>@devam.Tarih.ToString("dd.MM.yyyy")</td>
                    <td>@devam.GirisSaati</td>
                    <td>@devam.CikisSaati</td>
                    <td>@devam.OnayDurumu</td>
                </tr>
            }
        </tbody>
    </table>
}
