@model List<Talep>

@{
    ViewData["Title"] = "Talepler";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel(
             "Stajyer Talepleri",
             "Stajyerlerinizden istediğiniz belgeler; cevaplananların dosyalarını buradan indirebilirsiniz.",
             "Yeni Talep", "Talep", "Create"))" />

@if (!Model.Any())
{
    <div class="stk-bos-durum">
        <partial name="_Ikon" model="@("dosya")" />
        <h2>Henüz talep oluşturmadınız</h2>
        <p>"Yeni Talep" ile stajyerlerinizden CV veya belge isteyebilirsiniz.</p>
    </div>
}
else
{
    <div class="stk-tablo-kart">
        <table class="stk-tablo">
            <thead>
                <tr>
                    <th>Stajyer</th>
                    <th>Başlık</th>
                    <th>Tarih</th>
                    <th>Durum</th>
                    <th>Cevap</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var talep in Model)
                {
                    <tr>
                        <td class="stk-hucre-ad">@(talep.Stajyer.Kullanici?.AdSoyad ?? "—")</td>
                        <td>
                            @talep.Baslik
                            @if (talep.DosyaIstensin)
                            {
                                <span class="stk-rozet stk-rozet-mavi">Dosya istendi</span>
                            }
                        </td>
                        <td>@talep.OlusturmaTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>
                            @if (talep.Durum == TalepDurumu.Bekliyor)
                            {
                                <span class="stk-rozet stk-rozet-amber">Bekliyor</span>
                            }
                            else
                            {
                                <span class="stk-rozet stk-rozet-yesil">Tamamlandı</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(talep.CevapMetni))
                            {
                                <div>@talep.CevapMetni</div>
                            }
                            @if (!string.IsNullOrEmpty(talep.CevapDosyaAdi))
                            {
                                <a asp-action="DosyaIndir" asp-route-id="@talep.Id" class="stk-btn-hafif stk-btn-hafif-mavi mt-1">
                                    <partial name="_Ikon" model="@("indir")" />
                                    @(talep.CevapDosyaOrijinalAdi ?? "Dosyayı indir")
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
