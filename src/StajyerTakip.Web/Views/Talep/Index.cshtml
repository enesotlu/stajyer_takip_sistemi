@model List<Talep>

@{
    ViewData["Title"] = "Talepler";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel(
             "Stajyer Talepleri",
             "Stajyerlerinizden istediğiniz belgeler; cevaplananların dosyalarını buradan indirebilirsiniz.",
             "Yeni Talep", "Talep", "Create"))" />

@if (!Model.Any())
{
    <div class="stk-bos-durum">
        <partial name="_Ikon" model="@("dosya")" />
        <h2>Henüz talep oluşturmadınız</h2>
        <p>"Yeni Talep" ile stajyerlerinizden CV veya belge isteyebilirsiniz.</p>
    </div>
}
else
{
    <div class="stk-tablo-kart">
        <table class="stk-tablo">
            <thead>
                <tr>
                    <th>Stajyer</th>
                    <th>Başlık</th>
                    <th>Tarih</th>
                    <th>Son Tarih</th>
                    <th>Durum</th>
                    <th>Cevap</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var talep in Model)
                {
                    <tr>
                        <td class="stk-hucre-ad">@(talep.Stajyer.Kullanici?.AdSoyad ?? "—")</td>
                        <td>
                            @talep.Baslik
                            @if (talep.DosyaIstensin)
                            {
                                <span class="stk-rozet stk-rozet-mavi">Dosya istendi</span>
                            }
                        </td>
                        <td>@talep.OlusturmaTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@(talep.SonTarih?.ToString("dd.MM.yyyy") ?? "—")</td>
                        <td><partial name="_TalepDurumRozet" model="talep" /></td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(talep.CevapMetni))
                            {
                                <div>@talep.CevapMetni</div>
                            }
                            @if (!string.IsNullOrEmpty(talep.CevapDosyaAdi))
                            {
                                <a asp-action="DosyaIndir" asp-route-id="@talep.Id" class="stk-btn-hafif stk-btn-hafif-mavi mt-1">
                                    <partial name="_Ikon" model="@("indir")" />
                                    @(talep.CevapDosyaOrijinalAdi ?? "Dosyayı indir")
                                </a>
                            }
                            @if (talep.MentorNotu is not null)
                            {
                                <div class="text-muted mt-1"><small><strong>Önceki notun:</strong> @talep.MentorNotu</small></div>
                            }
                        </td>
                        <td>
                            <span class="stk-islem-hucre">
                                @if (talep.Durum == TalepDurumu.Tamamlandi)
                                {
                                    <details class="stk-teslim-detay">
                                        <summary class="stk-btn-hafif stk-btn-hafif-amber">Geri Gönder</summary>
                                        <form asp-action="GeriGonder" asp-route-id="@talep.Id" method="post" class="mt-2" style="min-width: 220px">
                                            <textarea name="mentorNotu" class="form-control form-control-sm mb-2" rows="2"
                                                      placeholder="Neden geri gönderiyorsun? (isteğe bağlı)"></textarea>
                                            <label class="form-label small mb-1">Yeni son tarih</label>
                                            <input name="yeniSonTarih" type="date" class="form-control form-control-sm mb-2" required />
                                            <button type="submit" class="stk-btn-hafif stk-btn-hafif-amber">Gönder</button>
                                        </form>
                                    </details>
                                }
                                else
                                {
                                    <a asp-action="Edit" asp-route-id="@talep.Id" class="stk-ikon-btn" title="Düzenle">
                                        <partial name="_Ikon" model="@("kalem")" />
                                    </a>
                                }
                                <form asp-action="Delete" asp-route-id="@talep.Id" method="post" class="d-inline"
                                      onsubmit="return confirm('Bu talebi silmek istediğinize emin misiniz?');">
                                    <button type="submit" class="stk-ikon-btn stk-ikon-btn-tehlike" title="Sil">
                                        <partial name="_Ikon" model="@("cop")" />
                                    </button>
                                </form>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
