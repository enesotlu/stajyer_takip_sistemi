@model List<Talep>

@{
    ViewData["Title"] = "Taleplerim (Mentör)";
}

<h1>Stajyer Talepleri</h1>
<p class="text-muted">Stajyerlerinden istediğin belgeler ve görevler; cevaplananların dosyalarını buradan indirebilirsin.</p>

@if (TempData["BilgiMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BilgiMesaji"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Talep</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">Henüz bir talep oluşturmadın.</div>
}
else
{
    <div class="table-wrap">
    <table class="table table-striped mb-0">
        <thead>
            <tr>
                <th>Stajyer</th>
                <th>Başlık</th>
                <th>Tarih</th>
                <th>Durum</th>
                <th>Cevap</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var talep in Model)
            {
                <tr>
                    <td>@(talep.Stajyer.Kullanici?.AdSoyad ?? "—")</td>
                    <td>
                        @talep.Baslik
                        @if (talep.DosyaIstensin)
                        {
                            <span class="badge bg-info text-dark">Dosya istendi</span>
                        }
                    </td>
                    <td>@talep.OlusturmaTarihi.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                    <td>
                        @if (talep.Durum == TalepDurumu.Bekliyor)
                        {
                            <span class="badge bg-warning text-dark">Bekliyor</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Tamamlandı</span>
                        }
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(talep.CevapMetni))
                        {
                            <div>@talep.CevapMetni</div>
                        }
                        @if (!string.IsNullOrEmpty(talep.CevapDosyaAdi))
                        {
                            <a asp-action="DosyaIndir" asp-route-id="@talep.Id" class="btn btn-sm btn-outline-primary mt-1">
                                📎 @(talep.CevapDosyaOrijinalAdi ?? "Dosyayı indir")
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
