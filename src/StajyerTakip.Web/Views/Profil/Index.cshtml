@model ProfilViewModel

@{
    ViewData["Title"] = "Profilim";
}

<h1>Profilim</h1>

<div class="card mb-3">
    <div class="card-body d-flex align-items-center gap-3 flex-wrap">
        <div class="stk-avatar stk-avatar-lg">
            @if (Model.ProfilFotografUrl is not null)
            {
                <img src="@Model.ProfilFotografUrl" alt="Profil fotoğrafı" />
            }
            else
            {
                <partial name="_Ikon" model="@("kisi")" />
            }
        </div>
        <div class="flex-grow-1">
            <div class="d-flex gap-2 flex-wrap">
                <form asp-action="FotografYukle" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap">
                    <input type="file" name="fotograf" class="form-control form-control-sm" style="max-width: 260px" accept=".png,.jpg,.jpeg" />
                    <button type="submit" class="btn btn-primary btn-sm">Fotoğraf Yükle</button>
                </form>
                @if (Model.ProfilFotografUrl is not null)
                {
                    <form asp-action="FotografKaldir" method="post">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Kaldır</button>
                    </form>
                }
            </div>
            <div class="form-text mb-0">İzinli türler: PNG, JPG - en fazla 3 MB.</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">Hesap Bilgileri</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Ad Soyad</dt>
                    <dd class="col-sm-8">@Model.AdSoyad</dd>

                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Rol</dt>
                    <dd class="col-sm-8"><span class="stk-rozet @RolGorunumleri.RozetSinifi(Model.Rol)">@RolGorunumleri.Ad(Model.Rol)</span></dd>

                    <dt class="col-sm-4">Kayıt Tarihi</dt>
                    <dd class="col-sm-8">
                        @(Model.KayitTarihi == default ? "-" : Model.KayitTarihi.ToLocalTime().ToString("dd.MM.yyyy"))
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    @if (Model.StajyerProfili is not null)
    {
        var s = Model.StajyerProfili;
        bool aktif = s.BaslangicTarihi.Date <= DateTime.Today && DateTime.Today <= s.BitisTarihi.Date;
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Staj Bilgileri</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Okul</dt>
                        <dd class="col-sm-8">@s.Okul</dd>

                        <dt class="col-sm-4">Bölüm</dt>
                        <dd class="col-sm-8">@s.Bolum</dd>

                        <dt class="col-sm-4">Staj Dönemi</dt>
                        <dd class="col-sm-8">@s.BaslangicTarihi.ToString("dd.MM.yyyy") - @s.BitisTarihi.ToString("dd.MM.yyyy")</dd>

                        <dt class="col-sm-4">Durum</dt>
                        <dd class="col-sm-8">
                            @if (aktif)
                            {
                                <span class="badge bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Pasif</span>
                            }
                        </dd>

                        <dt class="col-sm-4">Mentör</dt>
                        <dd class="col-sm-8">@Model.MentorAdSoyad (@s.Mentor.Unvan)</dd>

                        <dt class="col-sm-4">Departman</dt>
                        <dd class="col-sm-8">@s.Departman.Ad</dd>
                    </dl>
                </div>
            </div>
        </div>
    }
    else if (Model.MentorProfili is not null)
    {
        var m = Model.MentorProfili;
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Mentörlük Bilgileri</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Unvan</dt>
                        <dd class="col-sm-8">@m.Unvan</dd>

                        <dt class="col-sm-4">Departman</dt>
                        <dd class="col-sm-8">@m.Departman.Ad</dd>
                    </dl>
                </div>
            </div>
        </div>
    }
</div>
