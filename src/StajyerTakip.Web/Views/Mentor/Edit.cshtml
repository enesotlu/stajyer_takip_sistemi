@model Mentor

@{
    ViewData["Title"] = "Mentör Düzenle";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel("Mentör Düzenle", "Mentörün unvan ve departman bilgilerini güncelleyin."))" />

<div class="stk-form-kart">
    <form asp-action="Edit" method="post">
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Unvan" class="form-label"></label>
            <input asp-for="Unvan" class="form-control" />
            <span asp-validation-for="Unvan" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="DepartmanId" class="form-label"></label>
            <select asp-for="DepartmanId" asp-items="ViewBag.DepartmanId" class="form-select">
                <option value="">-- Seçiniz --</option>
            </select>
            <span asp-validation-for="DepartmanId" class="text-danger"></span>
        </div>

        <div class="stk-form-eylemler">
            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="stk-btn-iptal">Vazgeç</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
