@model Mentor

@{
    ViewData["Title"] = "Mentör Sil";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel("Mentörü Sil", "Bu işlem geri alınamaz; silmeden önce kontrol edin."))" />

<div class="stk-form-kart">
    <div class="stk-banner stk-banner-uyari">
        <partial name="_Ikon" model="@("unlem")" />
        <div><strong>@Model.Unvan</strong> mentörünü silmek istediğine emin misin?</div>
    </div>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <div class="stk-form-eylemler">
            <button type="submit" class="btn btn-danger">Sil</button>
            <a asp-action="Index" class="stk-btn-iptal">Vazgeç</a>
        </div>
    </form>
</div>
