@model RegisterViewModel

@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_AuthLayout";
}

<h1>Kayıt</h1>
<p class="stk-auth-lead">Hesabınızı oluşturun; başvurunuz onaylandığında sisteme erişebilirsiniz.</p>

<form asp-action="Register" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

    <div class="stk-input-grup mb-1">
        <label asp-for="AdSoyad" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/></svg>
        <input asp-for="AdSoyad" class="form-control" placeholder="Ad Soyad" />
    </div>
    <span asp-validation-for="AdSoyad" class="text-danger d-block mb-2"></span>

    <div class="stk-input-grup mb-1">
        <label asp-for="Email" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        <input asp-for="Email" class="form-control" placeholder="E-posta" autocomplete="username" />
    </div>
    <span asp-validation-for="Email" class="text-danger d-block mb-2"></span>

    <div class="stk-input-grup mb-1">
        <label asp-for="Sifre" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <input asp-for="Sifre" class="form-control stk-parola-alani" placeholder="Şifre" autocomplete="new-password" />
        <button type="button" class="stk-parola-goster" aria-label="Şifreyi göster veya gizle">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
    </div>
    <span asp-validation-for="Sifre" class="text-danger d-block mb-2"></span>

    <div class="stk-input-grup mb-1">
        <label asp-for="SifreTekrar" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <input asp-for="SifreTekrar" class="form-control stk-parola-alani" placeholder="Şifre (Tekrar)" autocomplete="new-password" />
        <button type="button" class="stk-parola-goster" aria-label="Şifreyi göster veya gizle">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
    </div>
    <span asp-validation-for="SifreTekrar" class="text-danger d-block mb-3"></span>

    @* Rol seçimi *@
    <div class="mb-2">
        <label class="form-label fw-semibold" style="font-size:0.85rem; color:#55647a; text-transform:uppercase; letter-spacing:0.05em;">
            Başvuru Rolü
        </label>
        <div class="d-flex gap-3">
            <div class="stk-rol-kart @(Model.TalepEdilenRol == "Mentor" ? "secili" : "")" id="rolKartMentor" onclick="rolSec('Mentor')">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-6 8-6s8 2 8 6"/><path d="M16 3.5a3 3 0 0 1 0 5.5"/></svg>
                <span>Mentör</span>
            </div>
            <div class="stk-rol-kart @(Model.TalepEdilenRol == "Stajyer" ? "secili" : "")" id="rolKartStajyer" onclick="rolSec('Stajyer')">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                <span>Stajyer</span>
            </div>
        </div>
        <input asp-for="TalepEdilenRol" type="hidden" id="talepEdilenRolInput" />
        <span asp-validation-for="TalepEdilenRol" class="text-danger d-block mt-1"></span>
    </div>

    @* Departman seçimi *@
    <div class="mb-3">
        <label asp-for="TalepEdilenDepartmanId" class="form-label fw-semibold" style="font-size:0.85rem; color:#55647a; text-transform:uppercase; letter-spacing:0.05em;">
            Departman
        </label>
        <select asp-for="TalepEdilenDepartmanId" asp-items="ViewBag.DepartmanListesi" class="form-select" style="border-radius:1rem; border-color:#dfe6ee; padding:0.75rem 1rem;">
            <option value="">— Departman seçin —</option>
        </select>
        <span asp-validation-for="TalepEdilenDepartmanId" class="text-danger d-block mt-1"></span>
    </div>

    <button type="submit" class="btn btn-primary">Kayıt Ol</button>

    <p class="stk-auth-alt">Zaten hesabınız var mı? <a asp-action="Login">Giriş yapın.</a></p>
</form>

<style>
    .stk-rol-kart {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.4rem;
        padding: 0.85rem;
        border: 2px solid #dfe6ee;
        border-radius: 1rem;
        cursor: pointer;
        color: #55647a;
        font-size: 0.9rem;
        font-weight: 500;
        transition: border-color 0.15s, background 0.15s, color 0.15s;
        user-select: none;
    }
    .stk-rol-kart:hover {
        border-color: var(--stk-accent);
        background: rgba(47, 111, 237, 0.04);
    }
    .stk-rol-kart.secili {
        border-color: var(--stk-accent);
        background: rgba(47, 111, 237, 0.08);
        color: var(--stk-accent);
    }
</style>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function rolSec(rol) {
            document.getElementById('talepEdilenRolInput').value = rol;
            document.getElementById('rolKartMentor').classList.toggle('secili', rol === 'Mentor');
            document.getElementById('rolKartStajyer').classList.toggle('secili', rol === 'Stajyer');
        }
        // Sayfa yüklenince mevcut değere göre kartı işaretle
        (function () {
            var mevcut = document.getElementById('talepEdilenRolInput').value;
            if (mevcut) rolSec(mevcut);
        })();
    </script>
}
