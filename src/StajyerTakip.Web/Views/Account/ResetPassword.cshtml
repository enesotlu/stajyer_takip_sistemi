@model ResetPasswordViewModel

@{
    ViewData["Title"] = "Şifre Sıfırla";
    Layout = "_AuthLayout";
}

<h1>Yeni Şifre Belirle</h1>
<p class="stk-auth-lead">Hesabın için yeni bir şifre gir.</p>

<form asp-action="ResetPassword" method="post">
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

    <div class="stk-input-grup mb-1">
        <label asp-for="Sifre" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <input asp-for="Sifre" class="form-control stk-parola-alani" placeholder="Yeni Şifre" autocomplete="new-password" autofocus />
        <button type="button" class="stk-parola-goster" aria-label="Şifreyi göster veya gizle">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
    </div>
    <span asp-validation-for="Sifre" class="text-danger d-block mb-2"></span>

    <div class="stk-input-grup mb-1">
        <label asp-for="SifreTekrar" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <input asp-for="SifreTekrar" class="form-control stk-parola-alani" placeholder="Şifre (Tekrar)" autocomplete="new-password" />
        <button type="button" class="stk-parola-goster" aria-label="Şifreyi göster veya gizle">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
    </div>
    <span asp-validation-for="SifreTekrar" class="text-danger d-block mb-3"></span>

    <button type="submit" class="btn btn-primary" data-yukleniyor="Kaydediliyor...">Şifreyi Güncelle</button>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
