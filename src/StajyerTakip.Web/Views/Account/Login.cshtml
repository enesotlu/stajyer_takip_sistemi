@model LoginViewModel

@{
    ViewData["Title"] = "Giriş Yap";
    Layout = "_AuthLayout";
}

<h1>Giriş</h1>
<p class="stk-auth-lead">Hesabınıza giriş yapın.</p>

@if (TempData["BasariMesaji"] != null)
{
    <div class="stk-banner stk-banner-basari" role="status">
        <partial name="_Ikon" model="@("onay-daire")" />
        <div>@TempData["BasariMesaji"]</div>
    </div>
}

<form asp-action="Login" method="post">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="stk-input-grup mb-1">
        <label asp-for="Email" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        <input asp-for="Email" class="form-control" placeholder="E-posta" autocomplete="username" autofocus />
    </div>
    <span asp-validation-for="Email" class="text-danger d-block mb-2"></span>

    <div class="stk-input-grup mb-1">
        <label asp-for="Sifre" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
        <input asp-for="Sifre" class="form-control stk-parola-alani" placeholder="Şifre" autocomplete="current-password" />
        <button type="button" class="stk-parola-goster" aria-label="Şifreyi göster veya gizle">
            <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6-10-6-10-6Z"/><circle cx="12" cy="12" r="3"/></svg>
        </button>
    </div>
    <span asp-validation-for="Sifre" class="text-danger d-block mb-2"></span>

    <div class="form-check my-3">
        <input asp-for="BeniHatirla" class="form-check-input" />
        <label asp-for="BeniHatirla" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-primary" data-yukleniyor="Giriş yapılıyor...">Giriş Yap</button>

    <p class="stk-auth-alt">Hesabınız yok mu? <a asp-action="Register">Kayıt olun.</a></p>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
