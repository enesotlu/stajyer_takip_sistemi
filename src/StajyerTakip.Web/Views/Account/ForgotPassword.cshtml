@model ForgotPasswordViewModel

@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_AuthLayout";
}

<h1>Şifremi Unuttum</h1>
<p class="stk-auth-lead">E-postanı gir, şifreni sıfırlaman için bir bağlantı gönderelim.</p>

<form asp-action="ForgotPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger text-center mb-3"></div>

    <div class="stk-input-grup mb-1">
        <label asp-for="Email" class="visually-hidden"></label>
        <svg class="stk-input-ikon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        <input asp-for="Email" class="form-control" placeholder="E-posta" autocomplete="username" autofocus />
    </div>
    <span asp-validation-for="Email" class="text-danger d-block mb-2"></span>

    <button type="submit" class="btn btn-primary" data-yukleniyor="Gönderiliyor...">Sıfırlama Bağlantısı Gönder</button>

    <p class="stk-auth-alt"><a asp-action="Login">Girişe dön.</a></p>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
