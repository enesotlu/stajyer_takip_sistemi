@using StajyerTakip.Core.Identity
@model List<ApplicationUser>

@{
    ViewData["Title"] = "Mentör Başvuruları";
    var departmanAdlari = (Dictionary<int, string>)ViewBag.DepartmanAdlari;
}

<h1>Mentör Başvuruları</h1>
<p class="text-muted">Mentör olarak başvuran kullanıcıları onaylayın veya reddedin.</p>

@if (TempData["BilgiMesaji"] != null)
{
    <div class="alert alert-success">@TempData["BilgiMesaji"]</div>
}
@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Bekleyen mentör başvurusu yok.</div>
}
else
{
    <div class="table-wrap">
    <table class="table table-striped mb-0">
        <thead>
            <tr>
                <th>Ad Soyad</th>
                <th>E-posta</th>
                <th>Talep Edilen Departman</th>
                <th>Kayıt Tarihi</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var kullanici in Model)
            {
                <tr>
                    <td>@kullanici.AdSoyad</td>
                    <td>@kullanici.Email</td>
                    <td>@(kullanici.TalepEdilenDepartmanId is int depId && departmanAdlari.TryGetValue(depId, out var depAd) ? depAd : "—")</td>
                    <td>@kullanici.KayitTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                    <td class="d-flex gap-2">
                        <a asp-action="MentorOnayla" asp-route-id="@kullanici.Id"
                           class="btn btn-sm btn-outline-primary">Onayla</a>
                        <form asp-action="Reddet" asp-route-id="@kullanici.Id" method="post"
                              onsubmit="return confirm('Bu başvuruyu reddetmek istediğinize emin misiniz?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">Reddet</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}
