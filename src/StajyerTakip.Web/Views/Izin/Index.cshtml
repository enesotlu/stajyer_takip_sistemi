@model List<Izin>

@{
    ViewData["Title"] = "İzin Talepleri";
}

<partial name="_SayfaBaslik"
         model="@(new SayfaBaslikModel(
             "İzin Talepleri",
             "Stajyerlerinizin izin taleplerini onaylayın veya reddedin."))" />

@if (Model.Count == 0)
{
    <div class="stk-bos-durum">
        <partial name="_Ikon" model="@("cikis")" />
        <h2>Bekleyen izin talebi yok</h2>
        <p>Stajyerleriniz izin talebi oluşturduğunda burada görünür.</p>
    </div>
}
else
{
    <div class="stk-tablo-kart">
        <table class="stk-tablo">
            <thead>
                <tr>
                    <th>Stajyer</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>
                    <th>Açıklama</th>
                    <th>Durum</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var izin in Model)
                {
                    <tr>
                        <td class="stk-hucre-ad">@izin.Stajyer.Kullanici.AdSoyad</td>
                        <td>@izin.BaslangicTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@izin.BitisTarihi.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@izin.Aciklama</td>
                        <td><partial name="_OnayDurumRozet" model="izin.OnayDurumu" /></td>
                        <td>
                            @if (izin.OnayDurumu == OnayDurumu.Bekliyor)
                            {
                                <span class="stk-islem-hucre">
                                    <form asp-action="Onayla" asp-route-id="@izin.Id" method="post" class="d-inline">
                                        <button type="submit" class="stk-btn-hafif stk-btn-hafif-yesil">
                                            <partial name="_Ikon" model="@("onay")" />
                                            Onayla
                                        </button>
                                    </form>
                                    <form asp-action="Reddet" asp-route-id="@izin.Id" method="post" class="d-inline stk-izin-reddet-form">
                                        <input type="text" name="mentorNotu" class="form-control form-control-sm d-inline-block w-auto" placeholder="Ret gerekçesi (opsiyonel)" />
                                        <button type="submit" class="stk-btn-hafif stk-btn-hafif-kirmizi">
                                            <partial name="_Ikon" model="@("kapat")" />
                                            Reddet
                                        </button>
                                    </form>
                                </span>
                            }
                            else if (!string.IsNullOrWhiteSpace(izin.MentorNotu))
                            {
                                <span class="text-muted small">@izin.MentorNotu</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
