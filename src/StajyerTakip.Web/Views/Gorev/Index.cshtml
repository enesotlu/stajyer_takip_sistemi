@model List<Gorev>

@{
    ViewData["Title"] = "Görevler";
}

<h1>Görevler</h1>

@if (TempData["HataMesaji"] != null)
{
    <div class="alert alert-danger">@TempData["HataMesaji"]</div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Yeni Görev Ata</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Stajyer</th>
            <th>Başlık</th>
            <th>Teslim Tarihi</th>
            <th>Durum</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var gorev in Model)
        {
            <tr>
                <td>@gorev.Stajyer.Okul / @gorev.Stajyer.Bolum</td>
                <td>@gorev.Baslik</td>
                <td>@gorev.TeslimTarihi.ToString("dd.MM.yyyy")</td>
                <td>@gorev.Durum</td>
                <td>
                    @if (gorev.Durum == GorevDurumu.Tamamlandi)
                    {
                        <form asp-action="GeriGonder" asp-route-id="@gorev.Id" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">Geri Gönder</button>
                        </form>
                    }
                    <form asp-action="Delete" asp-route-id="@gorev.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
