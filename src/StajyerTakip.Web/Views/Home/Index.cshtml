@using StajyerTakip.Core.Identity
@{
    ViewData["Title"] = "Ana Sayfa";
    bool rolVar = User.IsInRole(Roller.Yonetici) || User.IsInRole(Roller.Mentor) || User.IsInRole(Roller.Stajyer);
}

@if (!rolVar)
{
    <div class="alert alert-warning">
        <h4 class="alert-heading">Başvurunuz onay bekliyor</h4>
        <p>Kayıt oldunuz, ancak henüz bir rolünüz yok.</p>
        @{
            var talepEdilenRol = ViewBag.TalepEdilenRol as string;
        }
        @if (talepEdilenRol == Roller.Mentor)
        {
            <p class="mb-0">Mentör başvurunuz <strong>Yönetici</strong> tarafından onaylandığında sisteme erişebilirsiniz.</p>
        }
        else
        {
            <p class="mb-0">Stajyer başvurunuz departmanınızdaki <strong>Mentör</strong> tarafından onaylandığında sisteme erişebilirsiniz.</p>
        }
    </div>
}
else
{
    <div class="p-4 mb-4 bg-white rounded-3 border">
        <h1 class="h3">Hoş geldin, @(User.FindFirst("AdSoyad")?.Value ?? User.Identity!.Name)</h1>
        <p class="text-muted mb-0">Aşağıdan sana açık ekranlara hızlıca ulaşabilirsin.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-3">
        @if (User.IsInRole(Roller.Yonetici))
        {
            <div class="col">
                <a class="text-decoration-none" asp-controller="Rapor" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Raporlar</h5>
                        <p class="card-text text-muted">Staj programının özet sayıları ve grafikleri.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="OnayBekleyenler" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Mentör Başvuruları</h5>
                        <p class="card-text text-muted">Yeni kayıt olan mentör adaylarını onayla veya reddet.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="YoneticiAtama" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Mentör-Stajyer Ataması</h5>
                        <p class="card-text text-muted">Hangi mentörün hangi stajyerden sorumlu olacağını belirle.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="Departman" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Departmanlar</h5>
                        <p class="card-text text-muted">Departman kayıtlarını yönet.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="Mentor" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Mentörler</h5>
                        <p class="card-text text-muted">Onaylanmış mentörleri görüntüle ve yönet.</p>
                    </div></div>
                </a>
            </div>
        }
        @if (User.IsInRole(Roller.Yonetici) && !User.IsInRole(Roller.Mentor))
        {
            <div class="col">
                <a class="text-decoration-none" asp-controller="Stajyer" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Stajyerler</h5>
                        <p class="card-text text-muted">Tüm stajyerleri görüntüle.</p>
                    </div></div>
                </a>
            </div>
        }
        @if (User.IsInRole(Roller.Mentor))
        {
            <div class="col">
                <a class="text-decoration-none" asp-controller="StajyerBasvuru" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Stajyer Başvuruları</h5>
                        <p class="card-text text-muted">Departmanınıza yapılan başvuruları onayla veya reddet.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="Stajyer" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Stajyerlerim</h5>
                        <p class="card-text text-muted">Kendi stajyerlerini görüntüle.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="Gorev" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Görevler</h5>
                        <p class="card-text text-muted">Görev ata, geri gönder.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="Devam" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Devam Onayı</h5>
                        <p class="card-text text-muted">Bekleyen puantaj kayıtlarını onayla.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="Talep" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Talepler</h5>
                        <p class="card-text text-muted">Stajyerlerinden CV/belge iste, cevapları gör.</p>
                    </div></div>
                </a>
            </div>
        }
        @if (User.IsInRole(Roller.Stajyer))
        {
            <div class="col">
                <a class="text-decoration-none" asp-controller="Gorevlerim" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Görevlerim</h5>
                        <p class="card-text text-muted">Sana atanan görevleri gör, durumunu güncelle.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="Devamlarim" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Devam Kayıtlarım</h5>
                        <p class="card-text text-muted">Giriş/çıkış kaydı gir, aylık özetini gör.</p>
                    </div></div>
                </a>
            </div>
            <div class="col">
                <a class="text-decoration-none" asp-controller="Taleplerim" asp-action="Index">
                    <div class="card h-100"><div class="card-body">
                        <h5 class="card-title">Taleplerim</h5>
                        <p class="card-text text-muted">Mentörünün senden istediklerini gör, CV/belge yükle.</p>
                    </div></div>
                </a>
            </div>
        }
    </div>
}
